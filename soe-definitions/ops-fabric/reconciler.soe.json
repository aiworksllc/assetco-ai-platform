{
  "id": "opsfabric-reconciler",
  "version": "1.0.0",
  "description": "SOE for reconciler agent. Daily reconciliation of positions, cash, and corporate actions against custodian records. READ-ONLY access to all source systems. Classifies breaks and routes to resolution queues.",
  "identity": {
    "agentName": "reconciler",
    "application": "OpsFabric",
    "role": "ReconciliationAnalysis",
    "allowedPersonas": ["reconciler"],
    "authorityLevel": "read-only-analysis",
    "environmentScope": ["production"],
    "euAiActClass": "LIMITED",
    "humanSupervisor": "maria.torres@assetco.com"
  },
  "dataAccess": {
    "readAllow": [
      "operations/positions/**",
      "eagle-pace/positions/**",
      "eagle-pace/cash/**",
      "eagle-pace/corporate-actions/**",
      "custodian-records/bny-mellon/positions/**",
      "custodian-records/bny-mellon/cash/**",
      "custodian-records/state-street/positions/**",
      "custodian-records/state-street/cash/**",
      "dtcc/settlement-data/**",
      "operations/corporate-actions/announcements/**",
      "operations/settlement/status/**"
    ],
    "readDeny": [
      "**/client-pii/**",
      "**/client-accounts/**",
      "trading/**",
      "alpha-engine/**",
      "research/**",
      "trading-strategy/**"
    ],
    "writeAllow": [
      "operations/reconciliation/breaks/**",
      "operations/reconciliation/reports/**",
      "operations/reconciliation/escalations/**"
    ],
    "writeDeny": [
      "operations/positions/**",
      "eagle-pace/**",
      "custodian-records/**",
      "operations/settlement/instructions/**",
      "operations/nav/**",
      "trading/**"
    ]
  },
  "toolActions": {
    "analysis": {
      "allow": [
        "classify-break --category *",
        "route-to-queue --break-id * --queue *",
        "generate-reconciliation-report --date *",
        "calculate-break-priority --value * --age *",
        "query-corporate-action --isin *"
      ],
      "deny": [
        "amend-position *",
        "delete-position *",
        "submit-custodian-instruction *",
        "modify-eagle-pace *",
        "correct-record *"
      ]
    },
    "bash": {
      "allow": [
        "compare-positions --internal * --custodian *",
        "identify-breaks --report-date *",
        "export-break-report --format *"
      ],
      "deny": [
        "rm *",
        "UPDATE *",
        "INSERT *",
        "DELETE *",
        "*amend*",
        "*modify*"
      ]
    },
    "edit": { "allowPaths": [], "denyPaths": ["**"] }
  },
  "riskBudget": {
    "dailyLimit": 500,
    "hourlyLimit": 60,
    "onDemandBurst": 15,
    "resetSchedule": "daily-at-midnight-ET",
    "escalateAt": 450,
    "hardLimitAction": "DENY_AND_ESCALATE"
  },
  "rateLimiting": {
    "backend": "HotCache",
    "windowSeconds": 300,
    "maxCallsPerWindow": 60
  },
  "sourceRecordImmutability": {
    "enforced": true,
    "description": "reconciler has zero write access to any source system. Modification to data being verified compromises reconciliation integrity.",
    "violationSeverity": "CRITICAL"
  }
}
